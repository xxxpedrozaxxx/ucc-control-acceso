# =============================================================
# VARIABLES DE ENTORNO — DESPLIEGUE LOCAL (Windows)
# =============================================================
# 1. Copia este archivo y renombralo a .env
# 2. Reemplaza TODOS los valores entre < >
# 3. NUNCA subas el .env real a Git
# =============================================================

# --- PostgreSQL -------------------------------------------
# Contrasena del usuario ucc_app (la que pusiste en 00_setup.sql)
DB_PASSWORD=CambiaEstoAhora123

# --- PostgREST --------------------------------------------
# Puerto donde escucha PostgREST (dejar en 3000 salvo conflicto)
PGRST_PORT=3000

# JWT Secret: cadena aleatoria larga (minimo 32 caracteres)
# Genera una en: https://generate-secret.vercel.app/64
# O con PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=<cadena-aleatoria-de-al-menos-32-caracteres>

# --- Frontend ---------------------------------------------
# Puerto donde se sirve la app React (80 = sin puerto en la URL)
FRONTEND_PORT=80

# IP del servidor en la red local (asignala fija en Windows)
SERVER_IP=192.168.1.100