# =============================================================
# .env PARA DESPLIEGUE LOCAL — copiar a la raiz del proyecto
# Renombrar a .env (reemplaza el .env de Supabase cloud)
# =============================================================

# URL del servidor local donde corre PostgREST
# Reemplaza 192.168.1.100 por la IP fija del servidor
VITE_SUPABASE_URL=http://192.168.1.100:3000

# JWT anon key generada localmente
# Instrucciones en DEPLOY.md seccion "Generar JWT_SECRET y anon key"
VITE_SUPABASE_ANON_KEY=<anon-key-generada-localmente>